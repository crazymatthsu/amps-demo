# Layer 2, environment "dev": a shared box. Several people, and several
# (env, flow) pairs, may run at once -- default.env's ports would collide, so
# this environment moves off them. AMPS_ENV and AMPS_FLOW are folded into the
# container name by the wrapper script, which is enough to keep flows apart;
# ports still have to move by hand because two containers cannot publish the
# same host port.
AMPS_PORT=19007
AMPS_WS_PORT=19008
AMPS_ADMIN_PORT=18085
AMPS_TZ=UTC
