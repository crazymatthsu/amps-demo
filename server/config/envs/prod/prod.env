# Layer 2, environment "prod". AMPS_IMAGE is still not set here -- see the
# note in default.env. A real production rollout would pin it in this file
# once there is an internal registry to pin it to; until then the instance
# refuses to start without an explicit export, which is the correct failure
# mode for "I forgot to specify the image" in this tier.
AMPS_TZ=UTC
AMPS_PLATFORM=
