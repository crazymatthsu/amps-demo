<?xml version="1.0" encoding="UTF-8"?>
<!--
  Business flow "fix42-chaining": FIX 4.2 order state built with AMPS doing the
  chain identity, not the client.

  This is the flow that backs the fix42-publisher module and
  docs/fix42-view/. The idea it exercises, in one sentence: the optional
  chaining key generator resolves the FIX cancel/replace chain
  (11 ClOrdID -> 41 OrigClOrdID) inside the server, so every message of one
  order chain lands on ONE SOW record without any client-side identity map.

  Two topic shapes, deliberately paired for every stream:

    <name>          KeyGenerator key-chaining, keys /11 + /41.
                    One record per order CHAIN. delta_publish merges each
                    D/G/F into it, so the record is the live blotter.

    <name>_audit    plain SOW keyed /11 (or /17 for executions).
                    One record per MESSAGE id - the audit trail, and the
                    system of record. Journalled below; the chained topics
                    are not, because they are derivable from it.

  The audit pairing is not decoration. Per the AMPS user guide the chaining
  module DROPS a message that resolves to two different chains ("the module
  will not generate a SOW key, and the message is not processed by AMPS"),
  which is acceptable for a derived blotter and unacceptable for an audit
  trail. So nothing is only ever published to a chained topic.

  Above the blotter, three json views (view/fix42/exposure/*) aggregate it
  by account, symbol and side: exposure per desk, with the parent and child
  levels kept apart. A fourth (view/fix42/recon/parent_vs_child) joins the
  parent level to the child level and projects the difference, so a group
  whose slices disagree with their parent is one filtered query away.
  Declared at the end of the SOW block, the join last.
-->
<AMPSConfig>

    <Name>amps-fix42-chaining</Name>

    <Admin>
        <InetAddr>8085</InetAddr>
        <SQLTransport>amps-websocket</SQLTransport>
        <FileName>./stats/stats.db</FileName>
        <Interval>10s</Interval>
    </Admin>

    <Transports>
        <!-- One transport, every message type. The publisher selects `fix` in
             its connection URI: tcp://host:9007/amps/fix. -->
        <Transport>
            <Name>amps-tcp</Name>
            <Type>tcp</Type>
            <InetAddr>9007</InetAddr>
            <ReuseAddr>true</ReuseAddr>
            <Protocol>amps</Protocol>
        </Transport>
        <Transport>
            <Name>amps-websocket</Name>
            <Type>tcp</Type>
            <InetAddr>9008</InetAddr>
            <ReuseAddr>true</ReuseAddr>
            <Protocol>websocket</Protocol>
        </Transport>
    </Transports>

    <Logging>
        <Target>
            <Protocol>stdout</Protocol>
            <Level>info</Level>
        </Target>
    </Logging>

    <!--
      ===================================================================
      Modules
      ===================================================================
      The chaining key generator is an OPTIONAL module: it ships in the
      release tarball as a shared library and does nothing until a topic asks
      for it by the <Name> given here.

      Verified present in this repo's image (AMPS 5.3.5.135) by listing
      /opt/amps/lib inside the image and grepping for "chaining"; if the
      library is missing from your build, the server refuses to start and
      says so by name.

      (An XML comment may not contain a double hyphen, which is why that
      check is described rather than pasted: every shell flag would end the
      comment. AMPS rejects the whole config for it - see the same warning in
      the default flow, and server/build.gradle.kts checkConfigXml, which
      catches it without needing a container.)
    -->
    <Modules>
        <Module>
            <Name>key-chaining</Name>
            <Library>libamps_id_chaining_key_generator.so</Library>
        </Module>
    </Modules>

    <!--
      ===================================================================
      SOW
      ===================================================================
      Topic names carry slashes (sow/fix42/orders). That is a naming
      convention only - AMPS topic names are opaque strings, and the slash
      has no filesystem meaning. It DOES mean %n cannot be used in
      <FileName>: %n expands to the topic name, so ./sow/%n.sow would ask for
      ./sow/sow/fix42/orders.sow, in directories nothing creates. Every
      topic below therefore names its SOW file explicitly.

      How the KeyGenerator block reads:

        <Key>/11</Key>   FIRST key = the PRIMARY: the id of THIS message. A
                         value never seen before opens a new chain.
        <Key>/41</Key>   secondary = a reference to a PREDECESSOR. When a
                         message carries one, the module looks up that
                         predecessor's chain and reuses its SOW key.
        <FileName>       the chain map, persisted. AMPS reloads it at startup,
                         so chains survive a restart - without this the SOW
                         would survive but the identity that built it would
                         not.
        <Validation>     records extra data to detect chains that WOULD have
                         merged had messages arrived in a different order.
                         On here because an out-of-order feed failing loudly
                         beats a silently split order.
    -->
    <SOW>

        <!-- ===== orders: D / G / F, parent chains and child slices alike =====
             A child order is a distinct FIX chain with its own 11/41
             lineage, so the module keeps it as its own record on the same
             topic; its first message carries no 41 that could point at the
             parent's chain. Tag 9000 (ParentOrderID) links it to the parent,
             carried as an ordinary field so filters can walk the hierarchy
             (/9000 = '<parent ClOrdID>'). -->
        <Topic>
            <Name>sow/fix42/orders</Name>
            <MessageType>fix</MessageType>
            <KeyGenerator>
                <Module>key-chaining</Module>
                <Options>
                    <Key>/11</Key>
                    <Key>/41</Key>
                    <FileName>./sow/fix42-orders.chain</FileName>
                    <Validation>true</Validation>
                </Options>
            </KeyGenerator>
            <FileName>./sow/fix42-orders.sow</FileName>
            <Durability>persistent</Durability>
        </Topic>

        <Topic>
            <Name>sow/fix42/orders_audit</Name>
            <MessageType>fix</MessageType>
            <Key>/11</Key>
            <FileName>./sow/fix42-orders-audit.sow</FileName>
            <Durability>persistent</Durability>
        </Topic>

        <!-- ===== executions (35=8) =====
             Two different keys, two different questions:

               execs        /37 OrderID  -> "latest execution state of this
                                            order", one record per order.
               execs_audit  /17 ExecID   -> "every execution report", one
                                            record each. ExecID is unique per
                                            8, so this is the fills history.

             Both keys are REQUIRED fields on anything published here: a SOW
             publish that lacks its key field is rejected. That is why the
             publisher's field selection for 35=8 always includes 37 and 17
             even though the TODO's field list names neither - see
             Fix42PublisherProperties for the check that enforces it. -->
        <Topic>
            <Name>sow/fix42/execs</Name>
            <MessageType>fix</MessageType>
            <Key>/37</Key>
            <FileName>./sow/fix42-execs.sow</FileName>
            <Durability>persistent</Durability>
        </Topic>

        <Topic>
            <Name>sow/fix42/execs_audit</Name>
            <MessageType>fix</MessageType>
            <Key>/17</Key>
            <FileName>./sow/fix42-execs-audit.sow</FileName>
            <Durability>persistent</Durability>
        </Topic>

        <!-- ===== cancel/replace rejects (35=9) =====
             Keyed /11: a 9 names the rejected REQUEST's ClOrdID, so one
             record per rejected request. Note that a 4.2 cancel-reject may
             carry 37=NONE when the target was never acked, which is exactly
             why this topic is not keyed on OrderID. -->
        <Topic>
            <Name>sow/fix42/rejects</Name>
            <MessageType>fix</MessageType>
            <Key>/11</Key>
            <FileName>./sow/fix42-rejects.sow</FileName>
            <Durability>persistent</Durability>
        </Topic>

        <!-- ===== exposure views: account x symbol x side =====
             Derived from the chained blotter, not from the execs topics. The
             blotter record already carries account (1), symbol (55) and side
             (54) from the 35=D next to the venue's absolute CumQty (14),
             LeavesQty (151), AvgPx (6) and OrderQty (38) from its reports, so
             a trade bust or correct is absorbed at order level before any
             view sees it. The execs topics carry no 1/55/54, and execs_audit
             would need per-ExecID bust logic to reach the same numbers.

             Two levels, split on tag 9000 and never summed together: a child
             slice's fills are already rolled up into its parent's 14/151, so
             one view over both levels counts every child share twice. The
             third view groups the children by their parent's ClOrdID, which
             is what a reader compares against the parent's own record.

             Cross-type: the blotter is fix-typed and the views are json, so
             the aggregates come out as numbers and a group with no fills
             renders its 0/0 AvgPx as null rather than 0. A json view over a
             fix topic must qualify EVERY reference as [fix].[topic]./tag, in
             the projection and the grouping alike; the filter may stay
             unqualified.

             The aggregates are deliberately bare. On this build (5.3.5.135)
             an aggregate nested in IF(), e.g. IF(SUM(/14) > 0, ..., 0),
             accumulates add-only on live updates: the old contribution is
             never subtracted when a record changes, so the value drifts, and
             only a restart (which rebuilds the view from the SOW) corrects
             it. The VWAP below is the vendor's own documented form; the 0/0
             it produces for an unfilled group needs no guard. Recorded, with
             the measurements, in docs/fix42-view/08-exposure-views.md.

             Views are derived, so they are not journalled, and they take no
             FileName: AMPS rebuilds them from the underlying topic at startup.
        -->
        <View>
            <Name>view/fix42/exposure/parent</Name>
            <MessageType>json</MessageType>
            <UnderlyingTopic>[fix].[sow/fix42/orders]</UnderlyingTopic>
            <Filter>/9000 IS NULL</Filter>
            <Projection>
                <Field>[fix].[sow/fix42/orders]./1 AS /Account</Field>
                <Field>[fix].[sow/fix42/orders]./55 AS /Symbol</Field>
                <Field>[fix].[sow/fix42/orders]./54 AS /Side</Field>
                <Field>COUNT([fix].[sow/fix42/orders]./11) AS /Orders</Field>
                <Field>SUM([fix].[sow/fix42/orders]./38) AS /OrderQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./151) AS /LeavesQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./14) AS /CumQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./14 * [fix].[sow/fix42/orders]./6) / SUM([fix].[sow/fix42/orders]./14) AS /AvgPx</Field>
            </Projection>
            <Grouping>
                <Field>[fix].[sow/fix42/orders]./1</Field>
                <Field>[fix].[sow/fix42/orders]./55</Field>
                <Field>[fix].[sow/fix42/orders]./54</Field>
            </Grouping>
        </View>

        <!-- Same shape over the child slices alone. -->
        <View>
            <Name>view/fix42/exposure/child</Name>
            <MessageType>json</MessageType>
            <UnderlyingTopic>[fix].[sow/fix42/orders]</UnderlyingTopic>
            <Filter>/9000 IS NOT NULL</Filter>
            <Projection>
                <Field>[fix].[sow/fix42/orders]./1 AS /Account</Field>
                <Field>[fix].[sow/fix42/orders]./55 AS /Symbol</Field>
                <Field>[fix].[sow/fix42/orders]./54 AS /Side</Field>
                <Field>COUNT([fix].[sow/fix42/orders]./11) AS /Orders</Field>
                <Field>SUM([fix].[sow/fix42/orders]./38) AS /OrderQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./151) AS /LeavesQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./14) AS /CumQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./14 * [fix].[sow/fix42/orders]./6) / SUM([fix].[sow/fix42/orders]./14) AS /AvgPx</Field>
            </Projection>
            <Grouping>
                <Field>[fix].[sow/fix42/orders]./1</Field>
                <Field>[fix].[sow/fix42/orders]./55</Field>
                <Field>[fix].[sow/fix42/orders]./54</Field>
            </Grouping>
        </View>

        <!-- The consistency check: every child slice rolled up under its
             parent's ClOrdID (tag 9000). A parent whose slices report what it
             reports has a row here equal to its own blotter record's 38, 14,
             151 and 6 (the last to the venue's rounding). -->
        <View>
            <Name>view/fix42/exposure/children_by_parent</Name>
            <MessageType>json</MessageType>
            <UnderlyingTopic>[fix].[sow/fix42/orders]</UnderlyingTopic>
            <Filter>/9000 IS NOT NULL</Filter>
            <Projection>
                <Field>[fix].[sow/fix42/orders]./9000 AS /ParentOrderID</Field>
                <Field>COUNT([fix].[sow/fix42/orders]./11) AS /Orders</Field>
                <Field>SUM([fix].[sow/fix42/orders]./38) AS /OrderQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./151) AS /LeavesQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./14) AS /CumQty</Field>
                <Field>SUM([fix].[sow/fix42/orders]./14 * [fix].[sow/fix42/orders]./6) / SUM([fix].[sow/fix42/orders]./14) AS /AvgPx</Field>
            </Projection>
            <Grouping>
                <Field>[fix].[sow/fix42/orders]./9000</Field>
            </Grouping>
        </View>

        <!-- ===== reconciliation: the parent level against the child level =====
             A join of the two exposure views on account x symbol x side: one
             row per parent group, the child group's totals beside the parent's,
             and the difference projected as /CumQtyDelta and /LeavesQtyDelta.
             Declared AFTER the views it joins, deliberately: a join view's
             underlying topics must be defined earlier in the file.

             The join is a LEFT OUTER join from the first topic named. A parent
             group with no child slices (every mock parent but TSLA) keeps its
             row, with JSON null in every child column and so in both deltas.
             A row whose child columns are populated and whose deltas are zero
             reconciles; a break is a row with

               /ChildCumQty IS NOT NULL AND /CumQtyDelta != 0

             That selection belongs to the READER, not the view: <Filter> is
             not supported on a multi-topic (join) view on this build, so the
             view carries every parent group and a sow query with that filter
             picks out the breaks. ReconViewIT does exactly that, live.

             Account x symbol x side is the right key only when every parent
             in a group is sliced; a group mixing sliced and unsliced parents
             breaks by construction. A per-parent reconciliation
             (children_by_parent against the parent's own record) would need
             the parent's root ClOrdID kept on the blotter, since tag 11
             rotates on every amend, and is not built.

             The deltas are plain subtractions with no IF() around them, for
             the reason the exposure views keep their aggregates bare; null
             arithmetic already yields null, so there is nothing to guard.
        -->
        <View>
            <Name>view/fix42/recon/parent_vs_child</Name>
            <MessageType>json</MessageType>
            <UnderlyingTopic>
                <Join>[view/fix42/exposure/parent]./Account = [view/fix42/exposure/child]./Account</Join>
                <Join>[view/fix42/exposure/parent]./Symbol = [view/fix42/exposure/child]./Symbol</Join>
                <Join>[view/fix42/exposure/parent]./Side = [view/fix42/exposure/child]./Side</Join>
            </UnderlyingTopic>
            <Projection>
                <Field>[view/fix42/exposure/parent]./Account AS /Account</Field>
                <Field>[view/fix42/exposure/parent]./Symbol AS /Symbol</Field>
                <Field>[view/fix42/exposure/parent]./Side AS /Side</Field>
                <Field>[view/fix42/exposure/parent]./Orders AS /ParentOrders</Field>
                <Field>[view/fix42/exposure/child]./Orders AS /ChildOrders</Field>
                <Field>[view/fix42/exposure/parent]./CumQty AS /ParentCumQty</Field>
                <Field>[view/fix42/exposure/child]./CumQty AS /ChildCumQty</Field>
                <Field>[view/fix42/exposure/parent]./CumQty - [view/fix42/exposure/child]./CumQty AS /CumQtyDelta</Field>
                <Field>[view/fix42/exposure/parent]./LeavesQty AS /ParentLeavesQty</Field>
                <Field>[view/fix42/exposure/child]./LeavesQty AS /ChildLeavesQty</Field>
                <Field>[view/fix42/exposure/parent]./LeavesQty - [view/fix42/exposure/child]./LeavesQty AS /LeavesQtyDelta</Field>
            </Projection>
            <Grouping>
                <Field>[view/fix42/exposure/parent]./Account</Field>
                <Field>[view/fix42/exposure/parent]./Symbol</Field>
                <Field>[view/fix42/exposure/parent]./Side</Field>
            </Grouping>
        </View>

    </SOW>

    <!--
      ===================================================================
      TransactionLog
      ===================================================================
      The audit topics are the system of record and get the journal. The
      chained blotter (sow/fix42/orders) and the latest-per-order execs topic
      are derivable by replaying the audit streams, so journalling them would
      record the same information twice - the reasoning in
      docs/src/transaction-log-sizing.md.
    -->
    <TransactionLog>
        <JournalDirectory>./journal</JournalDirectory>
        <PreallocatedJournalFiles>2</PreallocatedJournalFiles>
        <MinJournalSize>10MB</MinJournalSize>

        <Topic>
            <Name>sow/fix42/orders_audit</Name>
            <MessageType>fix</MessageType>
        </Topic>
        <Topic>
            <Name>sow/fix42/execs_audit</Name>
            <MessageType>fix</MessageType>
        </Topic>
        <Topic>
            <Name>sow/fix42/rejects</Name>
            <MessageType>fix</MessageType>
        </Topic>
    </TransactionLog>

</AMPSConfig>
