# Layer 3, business flow "maintenance": the nightly SOW-cleanup schedule
# (docs/src/scheduled-maintenance.md).
#
# This is the flow that actually needs this layer. "Every night at 8:30pm"
# is stated in the config's <Crontab> as a business rule: the close of a
# trading day, in the business's own timezone -- not "whatever timezone this
# environment happens to run in". So this flow pins AMPS_TZ regardless of
# environment, overriding whatever layer 2 set:
AMPS_TZ=America/New_York
