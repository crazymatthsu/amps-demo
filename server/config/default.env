# Layer 1 of 4 -- repo defaults. Sourced first, for every environment and
# every business flow; committed, and safe to run on any box unmodified.
#
# Layering order (each later layer overrides same-named keys from the one
# before it; a variable already exported in your shell overrides all of
# them -- see docs/src/server-env-layering.md):
#
#   1. server/config/default.env                       (this file)
#   2. server/config/envs/<AMPS_ENV>/<AMPS_ENV>.env     environment
#   3. server/config/flows/<AMPS_FLOW>/flow.env         business flow
#   4. server/config/envs/<AMPS_ENV>/<AMPS_FLOW>.local.env   instance override,
#      optional, gitignored -- never commit one
#
# AMPS_IMAGE is deliberately ABSENT from every layer in this repo, including
# the environment ones. There is no public AMPS server image (see
# server/scripts/amps.sh require_image / server/Containerfile), so leaving it
# unset here keeps that requirement real instead of silently defaulting to
# something wrong. A real deployment with its own internal registry would be
# the one place to set it, in envs/<env>/<env>.env.

AMPS_PORT=9007
AMPS_WS_PORT=9008
AMPS_ADMIN_PORT=8085
AMPS_BIN=/opt/amps/bin/ampServer
AMPS_PLATFORM=linux/amd64
AMPS_TZ=
AMPS_CONTAINER_PREFIX=amps-demo
