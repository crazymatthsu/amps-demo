# Build an AMPS image from an official release tarball.
#
# WHEN YOU NEED THIS
# ------------------
# Always. There is no public AMPS server image -- 60East ships the server as a
# release tarball only, so this is the one way to get an instance running.
# (docker.io/amps/ce advertises itself as "AMPS Community Edition" but is an
# unrelated Apache/MySQL/PHP product with no ampServer binary in it.)
#
# HOW
# ---
#   1. Download the Linux server tarball for your edition from 60East
#      (https://www.crankuptheamps.com/evaluate/ -- the download is behind an
#      email sign-up). The file is named something like
#      AMPS-5.3.5.3-Release-Linux.tar.gz.
#   2. Drop it in server/vendor/.
#   3. Build and use it:
#
#        podman build --platform linux/amd64 -f server/Containerfile \
#            -t amps-demo:5.3.5.3 \
#            --build-arg AMPS_TARBALL=AMPS-5.3.5.3-Release-Linux.tar.gz server
#
#        AMPS_IMAGE=amps-demo:5.3.5.3 ./server/scripts/amps.sh start
#
# --platform linux/amd64 is required on Apple Silicon and harmless elsewhere:
# the AMPS distribution is Linux x86_64 only, so the image must be amd64 even
# when the host is not. amps.sh passes the same flag when it runs the image.
#
# The tarball is not vendored into git: it is a third-party distribution with its
# own licence terms, and it is large. server/vendor/.gitignore keeps it out.

FROM docker.io/library/rockylinux:9

ARG AMPS_TARBALL=AMPS-5.3.5.3-Release-Linux.tar.gz

# AMPS ships as a self-contained tree; it needs little beyond libstdc++.
RUN dnf install -y --setopt=install_weak_deps=False \
        libstdc++ \
        libatomic \
        ca-certificates \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY vendor/${AMPS_TARBALL} /tmp/amps-dist

# -xf, not -xzf: 60East ships some releases as a plain .tar and others gzipped,
# and tar detects the compression itself.
RUN mkdir -p /opt/amps \
    && tar -xf /tmp/amps-dist -C /opt/amps --strip-components=1 \
    && rm -f /tmp/amps-dist \
    && test -x /opt/amps/bin/ampServer

# Matches the layout server/scripts/amps.sh bind-mounts.
RUN mkdir -p /amps/config /amps/data/sow /amps/data/journal /amps/data/stats

WORKDIR /amps/data

EXPOSE 9007 9008 8085

ENTRYPOINT ["/opt/amps/bin/ampServer"]
CMD ["/amps/config/amps-config.xml"]
